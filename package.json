{
  "name": "jellytank",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "gen": "python3 tools/gen.py",
    "riv:verify": "python3 tools/gen.py && ${RIVE:-$HOME/.rive/bin/rive} rive --verify",
    "riv:build": "python3 tools/gen.py && ${RIVE:-$HOME/.rive/bin/rive} rive --once && cp rive/build/jellytank.riv public/jellytank.riv",
    "riv:shot": "python3 tools/gen.py && ${RIVE:-$HOME/.rive/bin/rive} rive --screenshot --advance=60",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "node tools/e2e.mjs",
    "guard": "node tools/guard.mjs",
    "hooks": "node tools/guard.mjs --install-hook",
    "budget": "vite build --logLevel warn && node tools/budget.mjs",
    "budget:bytes": "vite build --logLevel warn && node tools/budget.mjs --bytes",
    "test:explore": "FC_SEED=random FC_SCALE=10 vitest run src/save.prop.test.ts src/tankcode.prop.test.ts src/progress.prop.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@rive-app/webgl2": "^2.42.1"
  }
}
